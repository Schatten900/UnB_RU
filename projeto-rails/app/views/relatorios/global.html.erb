              <td style="text-align: center;">2.100</td>
              <td style="text-align: center;">520</td>
              <td style="text-align: center;"><span style="background: #dcfce7; color: #166534; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem;">98%</span></td>
              <td style="text-align: right; font-weight: 600; color: #1e3a8a;">R$ 9.450,00</td>
            </tr>
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 0.75rem 0;"><strong>Restaurante 2</strong><br><small style="color: #64748b;">Campus Darcy Ribeiro</small></td>
              <td style="text-align: center;">720</td>
              <td style="text-align: center;">170</td>
              <td style="text-align: center;"><span style="background: #dcfce7; color: #166534; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem;">95%</span></td>
              <td style="text-align: right; font-weight: 600; color: #1e3a8a;">R$ 3.240,00</td>
            </tr>
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 0.75rem 0;"><strong>Restaurante 3</strong><br><small style="color: #64748b;">Campus Darcy Ribeiro</small></td>
              <td style="text-align: center;">710</td>
              <td style="text-align: center;">165</td>
              <td style="text-align: center;"><span style="background: #dcfce7; color: #166534; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem;">96%</span></td>
              <td style="text-align: right; font-weight: 600; color: #1e3a8a;">R$ 3.195,00</td>
            </tr>
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 0.75rem 0;"><strong>Restaurante 4</strong><br><small style="color: #64748b;">Campus Darcy Ribeiro</small></td>
              <td style="text-align: center;">480</td>
              <td style="text-align: center;">115</td>
              <td style="text-align: center;"><span style="background: #dcfce7; color: #166534; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem;">94%</span></td>
              <td style="text-align: right; font-weight: 600; color: #1e3a8a;">R$ 2.160,00</td>
            </tr>
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 0.75rem 0;"><strong>Restaurante 5</strong><br><small style="color: #64748b;">Campus Darcy Ribeiro</small></td>
              <td style="text-align: center;">460</td>
              <td style="text-align: center;">105</td>
              <td style="text-align: center;"><span style="background: #dcfce7; color: #166534; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem;">95%</span></td>
              <td style="text-align: right; font-weight: 600; color: #1e3a8a;">R$ 2.070,00</td>
            </tr>
            <tr style="border-bottom: 2px solid #e2e8f0;">
              <td style="padding: 0.75rem 0;"><strong>Restaurante 6</strong><br><small style="color: #64748b;">Campus Darcy Ribeiro</small></td>
              <td style="text-align: center;">350</td>
              <td style="text-align: center;">75</td>
              <td style="text-align: center;"><span style="background: #dcfce7; color: #166534; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem;">97%</span></td>
              <td style="text-align: right; font-weight: 600; color: #1e3a8a;">R$ 1.575,00</td>
            </tr>
          </tbody>
          <tfoot>
            <tr style="font-weight: bold; color: #0f172a; background: #f8fafc;">
              <td style="padding: 0.75rem;">Total Consolidado</td>
              <td style="text-align: center;">4.820</td>
              <td style="text-align: center;">1.150</td>
              <td style="text-align: center;">96,4% méd.</td>
              <td style="text-align: right; color: #1e3a8a;">R$ 21.690,00</td>
            </tr>
          </tfoot>
        </table>
      </section>

      <!-- Direita: Métodos de Liquidação e Distribuição por Refeição -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        
        <!-- Métodos de Liquidação -->
        <section style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem;">
          <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; color: #0f172a;">Métodos de Liquidação</h3>
          
          <div style="margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.3rem;">
              <span>PIX Institucional Instantâneo</span>
              <strong>72% <small style="color: #64748b;">(R$ 15.616,80)</small></strong>
            </div>
            <div style="width: 100%; height: 8px; background: #f1f5f9; border-radius: 4px; overflow: hidden;">
              <div style="width: 72%; height: 100%; background: #16a34a; border-radius: 4px;"></div>
