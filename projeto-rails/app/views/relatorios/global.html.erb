              <div>
                <strong>Café da Manhã</strong><br><small style="color: #64748b;">07:00 - 09:00</small>
              </div>
              <div style="text-align: right;">
                <strong>650 refs</strong><br><span style="color: #1e3a8a; font-size: 0.8rem;">R$ 2.925,00</span>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 0.6rem; border-radius: 6px; border: 1px solid #e2e8f0;">
              <div>
                <strong>Almoço</strong><br><small style="color: #64748b;">11:00 - 14:15</small>
              </div>
              <div style="text-align: right;">
                <strong>2.980 refs</strong><br><span style="color: #1e3a8a; font-size: 0.8rem;">R$ 13.410,00</span>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 0.6rem; border-radius: 6px; border: 1px solid #e2e8f0;">
              <div>
                <strong>Jantar</strong><br><small style="color: #64748b;">17:30 - 19:45</small>
              </div>
              <div style="text-align: right;">
                <strong>1.190 refs</strong><br><span style="color: #1e3a8a; font-size: 0.8rem;">R$ 5.355,00</span>
              </div>
            </div>
          </div>
        </section>

      </div>

    </div>
  </div>
</main>

