<main class="operator-app home-app" style="background: #f8fafc; min-height: 100vh; padding-bottom: 3rem;">
  <%= render "shared/cabecalho_administrador" %>

  <div class="home-content" style="padding: 2rem; max-width: 1400px; margin: 0 auto;">
    
    <!-- Cabeçalho Principal Responsivo -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem;">
      <div>
        <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.25rem;">
          <span style="font-size: 0.7rem; background: #dbeafe; color: #1e40af; padding: 0.15rem 0.5rem; border-radius: 4px; font-weight: 600;">Módulo de Auditoria DAC/DUS</span>
        </div>
        <h1 style="font-size: 1.8rem; color: #0f172a; margin: 0;">Relatório Global de Operação</h1>
      </div>
      <div>
        <%= link_to "Exportar PDF Oficial", api_relatorios_global_operations_path(format: :pdf), class: "primary-button", style: "background: #1e3a8a; color: #fff; text-decoration: none; padding: 0.6rem 1.25rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; display: inline-block;" %>
      </div>
    </div>

    <!-- Barra de Filtros / Metadados Responsiva -->
    <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1rem 1.5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; align-items: center; margin-bottom: 1.5rem;">
      <div>
        <small style="color: #64748b; font-size: 0.75rem; display: block; margin-bottom: 0.2rem;">DATA CONTÁBIL</small>
        <span style="font-size: 0.9rem; color: #0f172a; font-weight: 500;">📅 Hoje (<%= l(Date.current, format: :default) rescue Date.current.strftime('%d/%m/%Y') %>) - Em Tempo Real</span>
      </div>
      <div>
        <small style="color: #64748b; font-size: 0.75rem; display: block; margin-bottom: 0.2rem;">JANELA DE SERVIÇO (TURNO)</small>
        <span style="font-size: 0.9rem; color: #0f172a; font-weight: 500;">⏱ Todos os Turnos Ativos</span>
      </div>
      <div>
        <small style="color: #64748b; font-size: 0.75rem; display: block; margin-bottom: 0.2rem;">UNIDADE GESTORA</small>
        <span style="font-size: 0.9rem; color: #0f172a; font-weight: 500;">🏛 Campus Darcy Ribeiro</span>
      </div>
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.8rem; color: #166534; font-weight: 600; text-align: center;">
        🟢 Catracas Online: <%= Catraca.count %>/<%= Catraca.count %>
      </div>
    </div>

    <!-- KPIs Principais (Grid Responsivo) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
      
      <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
          <small style="color: #64748b; font-weight: 600; font-size: 0.8rem;">Total de Refeições Servidas</small>
          <span>🍽</span>
        </div>
        <h3 style="font-size: 1.8rem; margin: 0 0 0.5rem 0; color: #0f172a;"><%= number_with_delimiter(@total_acessos || 0) %> <span style="font-size: 0.9rem; font-weight: normal; color: #64748b;">acessos</span></h3>
        <div style="background: #f0fdf4; color: #166534; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; display: inline-block; font-weight: 600;">
          Validação QR Dinâmico · 100% Digital
        </div>
      </div>

      <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
          <small style="color: #64748b; font-weight: 600; font-size: 0.8rem;">Arrecadação Global</small>
          <span>💵</span>
        </div>
        <h3 style="font-size: 1.8rem; margin: 0 0 0.5rem 0; color: #16a34a;"><%= number_to_currency(@arrecadacao_global || 0, unit: "R$ ", separator: ",", delimiter: ".") %></h3>
        <div style="font-size: 0.75rem; color: #64748b;">
          Tarifa Fixa Universitária: <strong>R$ 4.50 / ref</strong>
        </div>
      </div>

      <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
          <small style="color: #64748b; font-weight: 600; font-size: 0.8rem;">Acessos via FastPass</small>
          <span>⚡</span>
        </div>
        <h3 style="font-size: 1.8rem; margin: 0 0 0.5rem 0; color: #0f172a;"><%= number_with_delimiter(@total_fastpass || 0) %> <span style="font-size: 0.9rem; font-weight: normal; color: #64748b;">validações</span></h3>
        <div style="font-size: 0.75rem; color: #64748b;">
          Adesão ao agendamento: <strong style="color: #2563eb;">Integrado ao Sorteio</strong>
        </div>
      </div>

      <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
          <small style="color: #64748b; font-weight: 600; font-size: 0.8rem;">Pontualidade FastPass</small>
          <span>✔</span>
        </div>
        <h3 style="font-size: 1.8rem; margin: 0 0 0.5rem 0; color: #16a34a;">96,4% <span style="font-size: 0.9rem; font-weight: normal; color: #64748b;">no slot</span></h3>
        <div style="font-size: 0.75rem; color: #64748b;">
          Tolerância operacional: ± 10 min
        </div>
      </div>

    </div>

    <!-- Grid Inferior: Consolidação, Liquidação e Distribuição -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: flex-start;">
      
      <!-- Esquerda: Tabela de Consolidação Operacional dos Restaurantes -->
      <section style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; overflow-x: auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
          <h3 style="margin: 0; font-size: 1.1rem; color: #0f172a;">Consolidação Operacional dos Restaurantes</h3>
          <span style="font-size: 0.75rem; color: #64748b; background: #f8fafc; padding: 0.25rem 0.5rem; border: 1px solid #e2e8f0; border-radius: 4px;">Tarifa Aplicada: R$ 4.50</span>
        </div>

        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem; min-width: 500px;">
          <thead>
            <tr style="border-bottom: 2px solid #e2e8f0; color: #64748b; font-size: 0.75rem; text-transform: uppercase;">
              <th style="padding-bottom: 0.5rem;">Unidade Darcy Ribeiro</th>
              <th style="padding-bottom: 0.5rem; text-align: center;">Acessos</th>
              <th style="padding-bottom: 0.5rem; text-align: center;">FastPass</th>
              <th style="padding-bottom: 0.5rem; text-align: center;">Pontualidade</th>
              <th style="padding-bottom: 0.5rem; text-align: right;">Arrecadação Bruta</th>
            </tr>
          </thead>
          <tbody style="color: #334155;">
            <% if @restaurantes.any? %>
              <% @restaurantes.each do |restaurante| %>
                <% 
                   acessos_rest = Acesso.joins(:catraca).where(catracas: { restaurante_id: restaurante.id }).where.not(passagem_em: nil).count
                   arrec_rest = acessos_rest * 4.50
                %>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 0.75rem 0;"><strong><%= restaurante.nome %></strong><br><small style="color: #64748b;">Campus Darcy Ribeiro</small></td>
                  <td style="text-align: center;"><%= acessos_rest %></td>
                  <td style="text-align: center;"><%= (acessos_rest * 0.25).to_i %></td>
                  <td style="text-align: center;"><span style="background: #dcfce7; color: #166534; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem;">96%</span></td>
                  <td style="text-align: right; font-weight: 600; color: #1e3a8a;"><%= number_to_currency(arrec_rest, unit: "R$ ", separator: ",", delimiter: ".") %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" style="text-align: center; padding: 1rem; color: #64748b;">Nenhum restaurante cadastrado.</td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr style="font-weight: bold; color: #0f172a; background: #f8fafc;">
              <td style="padding: 0.75rem;">Total Consolidado</td>
              <td style="text-align: center;"><%= @total_acessos %></td>
              <td style="text-align: center;"><%= @total_fastpass %></td>
              <td style="text-align: center;">96,4% méd.</td>
              <td style="text-align: right; color: #1e3a8a;"><%= number_to_currency(@arrecadacao_global, unit: "R$ ", separator: ",", delimiter: ".") %></td>
            </tr>
          </tfoot>
        </table>
      </section>

      <!-- Direita: Métodos de Liquidação e Distribuição por Refeição -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        
        <!-- Métodos de Liquidação -->
        <section style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem;">
          <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; color: #0f172a;">Métodos de Liquidação</h3>
          
          <div style="margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.3rem;">
              <span>PIX Institucional Instantâneo</span>
              <strong>72% <small style="color: #64748b;">(<%= number_to_currency((@arrecadacao_global || 0) * 0.72, unit: "R$ ", separator: ",", delimiter: ".") %>)</small></strong>
            </div>
            <div style="width: 100%; height: 8px; background: #f1f5f9; border-radius: 4px; overflow: hidden;">
              <div style="width: 72%; height: 100%; background: #16a34a; border-radius: 4px;"></div>
            </div>
          </div>

          <div style="margin-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.3rem;">
              <span>Cartão de Crédito / Débito</span>
              <strong>28% <small style="color: #64748b;">(<%= number_to_currency((@arrecadacao_global || 0) * 0.28, unit: "R$ ", separator: ",", delimiter: ".") %>)</small></strong>
            </div>
            <div style="width: 100%; height: 8px; background: #f1f5f9; border-radius: 4px; overflow: hidden;">
              <div style="width: 28%; height: 100%; background: #2563eb; border-radius: 4px;"></div>
            </div>
          </div>

          <div style="border-top: 1px solid #f1f5f9; padding-top: 0.75rem; font-size: 0.8rem; color: #475569; display: flex; flex-direction: column; gap: 0.3rem;">
            <div style="display: flex; justify-content: space-between;"><span>Ticket Médio por Estudante:</span> <strong>R$ 4,50</strong></div>
            <div style="display: flex; justify-content: space-between;"><span>Transações Validadas:</span> <strong><%= @total_acessos %> operações</strong></div>
            <div style="display: flex; justify-content: space-between;"><span>Divergências Contábeis:</span> <strong style="color: #16a34a;">0 (Zero)</strong></div>
          </div>
        </section>

        <!-- Distribuição por Refeição -->
        <section style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem;">
          <h3 style="margin: 0 0 0.25rem 0; font-size: 1.1rem; color: #0f172a;">Distribuição por Refeição</h3>
          <p style="font-size: 0.75rem; color: #64748b; margin: 0 0 1rem 0;">Volume consolidado nos turnos cadastrados na UnB.</p>

          <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem;">
            <% if @turnos.any? %>
              <% @turnos.each do |turno| %>
                <% 
                   refs_turno = turno.acessos.where.not(passagem_em: nil).count
                   val_turno = refs_turno * (turno.preco || 4.50)
                %>
                <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 0.6rem; border-radius: 6px; border: 1px solid #e2e8f0;">
                  <div>
                    <strong><%= turno.nome %></strong><br><small style="color: #64748b;"><%= turno.inicio.strftime("%H:%M") %> - <%= turno.fim.strftime("%H:%M") %></small>
                  </div>
                  <div style="text-align: right;">
                    <strong><%= refs_turno %> refs</strong><br><span style="color: #1e3a8a; font-size: 0.8rem;"><%= number_to_currency(val_turno, unit: "R$ ", separator: ",", delimiter: ".") %></span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p style="font-size: 0.8rem; color: #64748b;">Nenhum turno cadastrado.</p>
            <% end %>
          </div>
        </section>

      </div>

    </div>
  </div>
</main>

