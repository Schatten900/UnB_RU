      <div>
        <small style="color: #64748b; font-size: 0.75rem; display: block; margin-bottom: 0.2rem;">DATA CONTÁBIL</small>
        <span style="font-size: 0.9rem; color: #0f172a; font-weight: 500;">📅 Hoje (24/10/2025) - Em Tempo Real</span>
      </div>
      <div>
        <small style="color: #64748b; font-size: 0.75rem; display: block; margin-bottom: 0.2rem;">JANELA DE SERVIÇO (TURNO)</small>
