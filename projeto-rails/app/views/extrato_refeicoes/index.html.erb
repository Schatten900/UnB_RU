<main class="operator-app home-app statement-app">
  <%= render "shared/cabecalho_estudante" %>
  <div class="statement-content">
    <section class="statement-heading" aria-labelledby="statement-title">
      <div><p class="eyebrow">Portal do Restaurante Universitário</p><h1 id="statement-title">Extrato e Histórico de Refeições</h1><p class="welcome-details">Matrícula: <strong><%= usuario_atual.matricula %></strong></p></div>
      <div class="statement-actions">
        <%= link_to "▣ Exportar PDF", student_exportar_historico_path(request.query_parameters.slice("periodo", "mes_referencia", "evento", "restaurante_id", "metodo")), data: { turbo: false } %>
        <button type="button" disabled title="Impressão disponível em breve"><span aria-hidden="true">▤</span> Imprimir</button>
      </div>
    </section>

    <div class="statement-metrics">
      <section class="statement-metric">
        <h2>Total gasto no mês <span class="statement-icon-red" aria-hidden="true">▣</span></h2>
        <strong><%= moeda_extrato(@gasto_mes) %></strong>
        <p><span>Débitos registrados neste mês</span><b class="statement-red">Total consumido</b></p>
      </section>
      <section class="statement-metric">
        <h2>Refeições realizadas <span class="statement-icon-green" aria-hidden="true">♜</span></h2>
        <strong><%= @refeicoes_mes %><small> refeições</small></strong>
        <p><span>Passagens confirmadas neste mês</span></p>
      </section>
      <section class="statement-metric">
        <h2>Total recarregado <span class="statement-icon-blue" aria-hidden="true">▣</span></h2>
        <strong class="statement-green"><%= moeda_extrato(@recarga_mes) %></strong>
        <p><span><%= @quantidade_recargas_mes %> recargas concluídas</span><b>Saldo restante: <%= moeda_extrato(usuario_atual.saldo) %></b></p>
      </section>
    </div>

    <section class="statement-filters" aria-labelledby="statement-filters-title">
      <div class="statement-section-heading"><h2 id="statement-filters-title"><span aria-hidden="true">☷</span> Filtros de auditoria e consulta</h2><%= link_to "↻ Limpar filtros", student_extrato_refeicoes_path %></div>
      <%= form_with url: student_extrato_refeicoes_path, method: :get do |form| %>
        <div class="statement-filter-grid">
          <div><%= form.label :periodo, "Período de referência" %><%= form.select :periodo, [["Últimos 30 dias", "30"], ["Mês atual", "mes"], ["Todo o histórico", "todos"]], selected: @periodo %></div>
          <div><%= form.label :mes_referencia, "Mês específico (opcional)" %><%= form.month_field :mes_referencia, value: params[:mes_referencia] %></div>
          <div><%= form.label :evento, "Tipo de refeição / Evento" %><%= form.select :evento, [["Todas as refeições e recargas", ""], ["Recarga de saldo", "recarga"]] + @turnos.map { |turno| [turno.nome, "turno:#{turno.id}"] }, selected: params[:evento] %></div>
          <div><%= form.label :restaurante_id, "Restaurante" %><%= form.collection_select :restaurante_id, @restaurantes, :id, :nome, { include_blank: "Todos os restaurantes", selected: params[:restaurante_id] } %></div>
          <div><%= form.label :metodo, "Forma de acesso / pagamento" %><%= form.select :metodo, [["Todos os métodos", ""], ["Comum", "comum"], ["FastPass", "fastpass"], ["PIX", "pix"], ["Cartão de crédito", "cartao_credito"]], selected: params[:metodo] %></div>
        </div>
        <div class="statement-filter-submit"><small>Os indicadores acima representam o mês atual. O mês específico tem prioridade sobre o período. Filtrar por restaurante exibe apenas refeições.</small><%= form.submit "Aplicar filtros" %></div>
      <% end %>
    </section>

    <section class="statement-records" aria-labelledby="statement-records-title">
      <div class="statement-records-heading"><h2 id="statement-records-title">Lançamentos Contábeis e Registros de Catraca <span><%= @total %> totais</span></h2><small>Registros da sua conta</small></div>
      <div class="statement-table-scroll">
        <table class="statement-table">
          <thead><tr><th scope="col">Data e hora</th><th scope="col">Refeição / Evento</th><th scope="col">Restaurante / Origem</th><th scope="col">Método de acesso</th><th scope="col">Valor</th><th scope="col">Comprovante</th></tr></thead>
          <tbody>
            <% @lancamentos.each do |item| %>
              <tr class="<%= 'statement-credit-row' if item[:tipo] == 'recarga' %>">
                <td><div class="statement-date"><span aria-hidden="true">●</span><div><strong><%= item[:data_hora].in_time_zone("America/Sao_Paulo").strftime("%d/%m/%Y, %H:%M") %></strong><small>Horário de Brasília</small></div></div></td>
                <td><span class="statement-event <%= item[:tipo] == 'recarga' ? 'statement-event-credit' : '' %>"><%= item[:nome] %></span></td>
                <td><strong><%= item[:local] %></strong><small><%= item[:detalhe] %></small></td>
                <td><span class="statement-method"><%= item[:metodo_nome] %></span></td>
                <td class="statement-amount <%= item[:tipo] == 'recarga' ? 'statement-green' : 'statement-red' %>"><%= item[:tipo] == "recarga" ? "+" : "−" %> <%= moeda_extrato(item[:valor]) %></td>
                <td><button type="button" class="statement-receipt" disabled title="Comprovantes disponíveis em breve">▣ Ver recibo</button></td>
              </tr>
            <% end %>
            <% if @lancamentos.empty? %><tr><td colspan="6" class="statement-empty">Nenhum lançamento encontrado para os filtros selecionados.</td></tr><% end %>
          </tbody>
        </table>
      </div>
      <div class="statement-pagination">
        <p>Exibindo <strong><%= @total.zero? ? 0 : @inicio + 1 %>–<%= @inicio + @lancamentos.size %></strong> de <strong><%= @total %></strong> registros</p>
        <%= form_with url: student_extrato_refeicoes_path, method: :get, class: "statement-page-size" do |form| %>
          <% request.query_parameters.except("pagina", "por_pagina", "commit").each do |chave, valor| %><%= hidden_field_tag chave, valor %><% end %>
          <%= form.label :por_pagina, "Itens por página:" %><%= form.select :por_pagina, [5, 10, 20], selected: @por_pagina %><%= form.submit "Exibir" %>
        <% end %>
        <nav aria-label="Paginação do extrato">
          <% if @pagina > 1 %><%= link_to "«", pagina_extrato(1), aria: { label: "Primeira página" } %><%= link_to "‹", pagina_extrato(@pagina - 1), aria: { label: "Página anterior" } %><% end %>
          <% ([1, @paginas] + ((@pagina - 2)..(@pagina + 2)).to_a).uniq.sort.select { |pagina| pagina.between?(1, @paginas) }.each do |pagina| %>
            <%= link_to pagina, pagina_extrato(pagina), class: ("is-current" if pagina == @pagina), aria: { current: ("page" if pagina == @pagina), label: "Página #{pagina}" } %>
          <% end %>
          <% if @pagina < @paginas %><%= link_to "›", pagina_extrato(@pagina + 1), aria: { label: "Próxima página" } %><%= link_to "»", pagina_extrato(@paginas), aria: { label: "Última página" } %><% end %>
        </nav>
      </div>
    </section>
  </div>
</main>
