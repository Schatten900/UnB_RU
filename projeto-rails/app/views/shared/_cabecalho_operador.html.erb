<header class="topbar operator-topbar">
  <%= link_to ponto_configuracao_path, class: "brand" do %>
    <span class="brand-mark" aria-hidden="true">RU</span>
    <span class="operator-brand-copy">
      <span class="brand-copy"><strong>RU UnB</strong><small>Operacional</small></span>
      <small><%= @restaurante_operador&.nome || "Selecione um ponto de acesso" %></small>
    </span>
  <% end %>
  <nav class="main-nav" aria-label="Navegação do operador">
    <% [["Configuração de Ponto", ponto_configuracao_path], ["Terminal de Validação", terminal_validacao_path]].each do |nome, caminho| %>
      <%= link_to nome, caminho, class: (current_page?(caminho) ? "is-current" : nil), aria: { current: (current_page?(caminho) ? "page" : nil) } %>
    <% end %>
    <button type="button" class="operator-nav-pending" disabled title="Histórico Local estará disponível em breve">Histórico Local</button>
  </nav>
  <div class="operator-menu">
    <div class="operator-copy"><strong><%= usuario_atual.nome %></strong><small>Fiscal<%= " · Catraca #{@catraca_operador.id}" if @catraca_operador %></small></div>
    <%= button_to "Sair", logout_path, method: :delete, class: "logout-button" %>
  </div>
</header>
