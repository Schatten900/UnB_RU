<header class="topbar">
  <%= link_to student_inicio_path, class: "brand" do %>
    <span class="brand-mark" aria-hidden="true">RU</span>
    <span class="brand-copy"><strong>RU UnB Digital</strong><small>Portal do estudante</small></span>
  <% end %>
  <nav class="main-nav" aria-label="Navegação principal">
    <% [
      ["Início & Carteira", student_inicio_path],
      ["Recarga", student_recarga_path],
      ["Extrato", student_extrato_refeicoes_path],
      ["FastPass", student_fast_pass_path]
    ].each do |nome, caminho| %>
      <% atual = current_page?(caminho) || (caminho == student_extrato_refeicoes_path && controller_name == "extrato_refeicoes") %>
      <%= link_to nome, caminho, class: ("is-current" if atual), aria: { current: ("page" if atual) } %>
    <% end %>
  </nav>
  <div class="operator-menu">
    <% if usuario_atual %>
      <div class="operator-copy">
        <strong><%= usuario_atual.nome %></strong>
        <small><%= usuario_atual.funcionario? ? "Operador" : "Estudante" %></small>
      </div>
      <%= button_to "Sair", logout_path, method: :delete, class: "logout-button" %>
    <% else %>
      <%= link_to "Entrar", login_path, class: "menu-login-link" %>
    <% end %>
  </div>
</header>
