<main class="fastpass-app" data-controller="fastpass-quotas">
  <%= render "shared/cabecalho_administrador" %>

  <div class="fastpass-content">
    <% if flash[:notice] || flash[:alert] %><p role="status"><%= flash[:notice] || flash[:alert] %></p><% end %>
    <section class="fastpass-heading" aria-labelledby="fastpass-title">
      <div><p><%= @restaurante&.nome || "Nenhum restaurante cadastrado" %></p><h1 id="fastpass-title">Vagas e Cotas FastPass</h1></div>
      <div class="fastpass-actions">
        <button type="button" class="fastpass-reset" data-action="fastpass-quotas#distribute"><span aria-hidden="true">↻</span> Redistribuir<br> igualmente</button>
        <button type="submit" form="fastpass-quotas-form" class="fastpass-apply" <%= "disabled" if !@restaurante || @janelas.empty? %>><span aria-hidden="true">◎</span> Aplicar Cotas ao<br> Sorteio Selecionado</button>
      </div>
    </section>

    <%= form_with url: admin_vagas_fastpass_path, method: :get, class: "fastpass-restaurant-selector" do |form| %>
      <%= form.label :restaurante_id, "Restaurante" %>
      <%= form.collection_select :restaurante_id, @restaurantes, :id, :nome, { selected: @restaurante&.id }, { disabled: @restaurantes.empty? } %>
      <%= form.label :data, "Data do sorteio" %>
      <%= form.date_field :data, value: @data, min: Date.current, required: true %>
      <%= form.submit "Exibir grade", disabled: @restaurantes.empty? %>
      <small>Ao trocar de restaurante ou data, os ajustes não aplicados são descartados.</small>
    <% end %>

    <% if @restaurante %>
    <% if @sorteio %>
      <section class="fastpass-metric fastpass-daily">
        <p>Sorteio nº <%= @sorteio.id %> · <%= @sorteio.status.humanize %></p>
        <p>Executar o sorteio encerra as inscrições e utiliza as cotas já salvas de todos os restaurantes desta data.</p>
        <% if @sorteio.status == "aberto" %>
          <%= button_to "Executar sorteio", admin_sortear_fastpass_path,
                params: { sorteio_id: @sorteio.id, restaurante_id: @restaurante.id },
                data: { turbo: false } %>
        <% end %>
      </section>
    <% end %>
    <%= form_with url: admin_vagas_fastpass_path, method: :post, id: "fastpass-quotas-form", data: { turbo: false } do |form| %>
      <%= form.hidden_field :restaurante_id, value: @restaurante.id %>
      <%= form.hidden_field :data, value: @data, id: "cotas-data" %>
      <section class="fastpass-metric fastpass-daily">
        <%= form.label :cota_diaria, "Cota diária total de FastPass" %>
        <%= form.number_field :cota_diaria, value: @cota_diaria, min: 0, step: 1, required: true, data: { fastpass_quotas_target: "daily", action: "input->fastpass-quotas#distribute" } %>
        <small>Distribuída igualmente entre todas as janelas. Ajuste manualmente mantendo o total diário.</small>
      </section>
    <section class="fastpass-grid" aria-labelledby="fastpass-grid-title">
      <h2 id="fastpass-grid-title"><%= @restaurante.nome %>: Grade de Janelas · <%= @data.strftime("%d/%m/%Y") %></h2>

      <div class="fastpass-table-scroll">
        <table class="fastpass-table">
          <thead><tr><th scope="col">Janela de horário</th><th scope="col">Cota FastPass</th><th scope="col">Ajuste manual</th></tr></thead>
          <tbody>
            <% @janelas.each do |janela| %>
              <% inicio = janela.inicio.strftime("%H:%M"); fim = janela.fim.strftime("%H:%M"); cota = @cotas.fetch(janela.id, 0) %>
              <tr data-fastpass-quotas-target="row" >
                <th scope="row"><span class="fastpass-clock" aria-hidden="true">◷</span> <%= janela.turno.nome %> · <%= inicio %> - <%= fim %></th>
                <td class="fastpass-quota"><span data-quota-label><%= cota %></span> passes</td>
                <td>
                  <div class="fastpass-stepper">
                    <button type="button" data-action="fastpass-quotas#decrease" aria-label="Diminuir cota de <%= inicio %> a <%= fim %>">−</button>
                    <%= number_field_tag "cotas[#{janela.id}]", cota, min: 0, step: 1, required: true, aria: { label: "Cota de #{inicio} a #{fim}" }, data: { quota_value: true, action: "input->fastpass-quotas#updateTotal" } %>
                    <button type="button" data-action="fastpass-quotas#increase" aria-label="Aumentar cota de <%= inicio %> a <%= fim %>">+</button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="fastpass-total" role="status">Total ofertado em <%= @restaurante.nome %> <strong><span data-fastpass-quotas-target="total"><%= @cota_diaria %></span> passes</strong></div>
    </section>
    <% end %>
    <% if @janelas.empty? %><p>Cadastre janelas em Turnos e Time-frames para distribuir as cotas.</p><% end %>
    <% else %>
      <p class="fastpass-preview">Cadastre um restaurante para visualizar a grade de cotas.</p>
    <% end %>
  </div>
</main>
